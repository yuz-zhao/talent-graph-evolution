PGDATABASE=talentgraph_dev
PGUSER=talentgraph
PGPASSWORD=change-this-postgres-password
PGPORT_HOST=5433

NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=talentgraph_evidence_v2

API_PORT_HOST=3001
WEB_PORT=8080
JWT_SECRET=change-this-long-random-secret
# When the API is exposed directly, set the exact browser origin.
# Requests routed through the Nginx /api proxy remain same-origin.
CORS_ORIGIN=http://localhost:8080

# Optional AI services. Evidence-gated fallback remains available when omitted.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_URL=
