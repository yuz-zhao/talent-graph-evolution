    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "flatpickr": "^4.6.13",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "moment": "^2.29.4",
    "multer": "^2.2.0",
    "neo4j-driver": "^6.2.0",
    "openai": "^6.46.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.16.3",
    "pinia": "^3.0.4",
    "vue": "^3.2.20",
    "vue-flatpickr-component": "^11.0.3",
