{
  "name": "talent-graph-evolution",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "test:matching": "node --test server/matching-utils.test.js",
    "test:new-job-workflow": "node --test server/new-job-workflow.test.js",
    "test:rag": "node --test server/rag-core.test.js",
    "test:resume": "node --test server/resume-parser.test.js",
    "test:document": "node --test server/document-extractor.test.js",
    "test:graph-filter-e2e": "node --test server/graph-filter-query.test.js",
    "test:learning-closure": "node --test server/learning-closure.test.js",
    "test:evidence-governance": "node --test server/evidence-governance.test.js",
    "evaluate:rag-expanded": "node server/evaluate-rag.js",
    "build:duplicate-review": "node crawler/scripts/build_duplicate_review_queue.mjs",
    "evaluate:duplicate-review": "node crawler/scripts/evaluate_duplicate_review.mjs",
    "test:fallbacks": "node --test server/fallback-observability.test.js",
    "test:server": "node --test server/auth-utils.test.js server/compliance-utils.test.js server/document-extractor.test.js server/evidence-governance.test.js server/fallback-observability.test.js server/graph-filter-query.test.js server/learning-closure.test.js server/matching-utils.test.js server/new-job-workflow.test.js server/rag-core.test.js server/resume-parser.test.js",
    "test:server:coverage": "c8 npm run test:server",
    "test:web": "vitest run",
    "test:web:coverage": "vitest run --coverage",
    "test:python:coverage": "node scripts/run-python-tests.mjs",
    "test:coverage": "node scripts/run-coverage-suite.mjs",
    "test:core:coverage": "npm run test:server:coverage",
    "gold:validate": "node scripts/run-python-script.mjs crawler/scripts/validate_human_gold_v1.py",
    "validate:jd-test-kit": "node scripts/run-python-script.mjs crawler/scripts/validate_jd_test_kit.py",
    "evaluate:formal": "node scripts/run-python-script.mjs crawler/scripts/evaluate_human_gold_v1.py",
    "evaluate:resume-parser:frozen-test": "node crawler/scripts/evaluate_resume_parser_frozen_test.mjs",
    "evaluate:jd-match-diagnosis": "node crawler/scripts/evaluate_jd_match_diagnosis.mjs",
    "assert:reported-metrics": "node scripts/assert-reported-metrics.mjs",
    "build:match-training-queue": "node crawler/scripts/build_match_training_annotation_queue.mjs",
    "validate:match-training-annotations": "node crawler/scripts/validate_match_training_annotations.mjs",
    "export:match-review-csv": "node crawler/scripts/export_match_review_csv.mjs",
    "import:match-review-a": "node crawler/scripts/import_match_review_csv.mjs a",
    "import:match-review-b": "node crawler/scripts/import_match_review_csv.mjs b",
    "evaluate:v8:gold": "node crawler/scripts/evaluate_v8_human_gold.mjs",
    "validate:new-job-submission": "node scripts/run-python-script.mjs crawler/scripts/validate_new_job_submission.py",
    "validate:new-job-workflow": "node scripts/run-python-script.mjs crawler/scripts/validate_new_job_workflow.py",
    "build:evolution-review-case": "node scripts/run-python-script.mjs crawler/scripts/build_job_skill_evolution_review_case.py",
    "audit:skill-graph-quality": "node scripts/run-python-script.mjs knowledge_graph/audit_skill_graph_quality.py",
    "evaluate:new-job-evolution": "node scripts/run-python-script.mjs crawler/scripts/evaluate_new_job_and_evolution_validity.py",
    "validate:gnn-scope": "node scripts/run-python-script.mjs knowledge_graph/validate_gnn_claim_scope.py",
    "audit:compliance": "node server/audit-compliance.js",
    "audit:fallbacks": "node scripts/audit-critical-fallbacks.mjs",
    "audit:utf8": "node scripts/audit-utf8.mjs",
    "demo:build": "node scripts/run-python-script.mjs crawler/scripts/build_roadmap_demo.py",
    "demo:validate": "node scripts/run-python-script.mjs crawler/scripts/validate_roadmap_demo.py",
    "audit:behavior-readiness": "node scripts/audit-behavior-readiness.mjs",
    "architecture:build": "node scripts/build-algorithm-architecture.mjs",
    "roadmap:audit": "node scripts/audit-roadmap-stages.mjs",
    "docker:config": "docker compose --env-file .env.docker -f docker-compose.yml config",
    "docker:up": "docker compose --env-file .env.docker -f docker-compose.yml up -d postgres neo4j qdrant import-gold import-neo4j",
    "docker:full:up": "docker compose --env-file .env.docker -f docker-compose.yml up -d --build",
    "docker:e2e": "node scripts/docker-e2e-smoke.mjs",
    "audit:graph": "node knowledge_graph/validate-graph-contract.js",
    "build": "vite build",
    "preview": "vite preview"
